rules_version = '2';

// Cylinder Desk — who can read and change what.
// Owner: the Google account below. Everyone else needs a role set by the owner
// (or a manager) in the app's Settings page: manager, staff or viewer.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['hindusthansurgicals@gmail.com'];
    }

    function rolesDoc() { return /databases/$(database)/documents/settings/roles; }

    function me() {
      return signedIn() && exists(rolesDoc())
        ? get(rolesDoc()).data.get('users', {}).get(request.auth.uid, {})
        : {};
    }
    function myRole() { return me().get('role', ''); }

    function canRead()   { return isOwner() || myRole() in ['manager', 'staff', 'viewer']; }
    // "View only" (set by the owner in People) blocks every change for that person.
    function viewOnly()  { return me().get('viewOnly', false) == true; }
    function canWrite()  { return isOwner() || (myRole() in ['manager', 'staff'] && !viewOnly()); }
    function canManage() { return isOwner() || (myRole() == 'manager' && !viewOnly()); }

    // Per-person permissions set by the owner (Settings → People → Permissions).
    // Without a setting, the role's default applies (same defaults as the app).
    function roleDefault(k) {
      return myRole() == 'manager'
        || (myRole() == 'staff' && k in ['entries', 'cyl', 'cust', 'entry', 'editOwn', 'saveLoc', 'fill', 'insp']);
    }
    function can(k) {
      return isOwner() || (canWrite() && me().get('perm', {}).get(k, roleDefault(k)) == true);
    }

    // Each person keeps their own name card; anyone signed in may read names.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // "Last opened" list the owner sees in Settings.
    match /members/{uid} {
      allow read: if canManage() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Everyone signed in reads roles; only the owner changes roles and permissions.
    match /settings/roles {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    match /settings/company {
      allow read: if canRead();
      allow write: if canManage();
    }

    // Old Excel history: read-only after the one-time import.
    match /hist/{doc} {
      allow read: if canRead();
      allow write: if isOwner();
    }

    // DC / MT entries. Each person's entries live in documents ending with their id.
    // Without "edit anyone's entries", a person can write only their own documents.
    match /log/{doc} {
      allow read: if canRead();
      allow create, update: if can('editAny')
        || ((can('entry') || can('editOwn')) && doc.matches('.*_' + request.auth.uid));
      allow delete: if isOwner();
    }

    // Customers (one document with the whole list).
    match /cust/{doc} {
      allow read: if canRead();
      allow create: if can('newCust') || canManage();
      allow update: if canManage() || (
        canWrite()
        && request.resource.data.list.diff(resource.data.list).removedKeys().size() == 0
        && (can('newCust') || request.resource.data.list.diff(resource.data.list).addedKeys().size() == 0)
        && (can('newCust') || can('editCust') || can('saveLoc'))
      );
      allow delete: if isOwner();
    }

    // Cylinder master list: managers, or whoever handles purchases & sales.
    match /cyl/{doc} {
      allow read: if canRead();
      allow write: if canManage() || can('trade');
    }

    match /bill/{doc} {
      allow read: if canRead();
      allow write: if canManage() || can('bill');
    }

    match /trade/{doc} {
      allow read: if canRead();
      allow write: if canManage() || can('trade');
    }

    // Factory filling register and physical inspections: one document per day per person.
    match /fill/{doc} {
      allow read: if canRead();
      allow write: if canManage() || (can('fill') && doc.matches('.*_' + request.auth.uid));
    }
    // Dealers (other parties we fill for): the filling team can add them.
    match /dealers/{doc} {
      allow read: if canRead();
      allow write: if canManage() || can('fill');
    }
    // Tank readings per plant per day, and liquid purchases (batches): the filling team and managers.
    match /pday/{doc} {
      allow read: if canRead();
      allow write: if canManage() || can('fill');
    }
    match /lpur/{doc} {
      allow read: if canRead();
      allow write: if canManage() || can('fill');
    }
    // Documents & renewals and reminders (scans themselves live in Google Drive, only links here).
    match /rdoc/{doc} {
      allow read: if isOwner() || myRole() == 'manager' || can('docs');
      allow write: if canManage() || can('docs');
    }
    match /insp/{doc} {
      allow read: if canRead();
      allow write: if canManage() || (can('insp') && doc.matches('.*_' + request.auth.uid));
    }

    // Attendance, login register and location trail: each person writes only their own;
    // the owner and managers read everyone's.
    match /att/{doc} {
      allow read: if canManage() || (signedIn() && doc.matches('.*_' + request.auth.uid));
      // Own In / Out; owner and manager may correct times and delete photos.
      allow write: if canManage() || (signedIn() && myRole() in ['manager', 'staff'] && doc.matches('.*_' + request.auth.uid));
    }
    match /logins/{doc} {
      allow read: if canManage();
      allow create: if signedIn() && (isOwner() || myRole() != '') && doc.matches('.*_' + request.auth.uid);
    }
    match /loc/{doc} {
      allow read: if canManage();
      allow write: if signedIn() && myRole() in ['manager', 'staff'] && doc.matches('.*_' + request.auth.uid);
    }

    // Cancelled DC numbers and import records.
    match /reg/{doc} {
      allow read: if canRead();
      allow write: if canManage();
    }
  }
}
